# Where the app runs. OAuth redirect URIs are built from this.
APP_URL=http://localhost:3000

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/connect/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: 64 hex chars used to encrypt OAuth tokens. Generated into .data/ if unset.
# Generate with: openssl rand -hex 32
# ENCRYPTION_KEY=

# Optional (website on Vercel only): Google Analytics 4 measurement ID. Loads only after the visitor
# accepts the cookie banner, and only on the website (/) and web demo (/demo), never in the desktop app.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional: max emails scanned per account (default 50000)
# SYNC_LIMIT=50000
