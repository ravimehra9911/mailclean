{
  "name": "mailclean",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "desktop:dev": "MAILCLEAN_DEV_URL=http://localhost:3000 electron electron",
    "desktop:prepare": "next build && node scripts/prepare-desktop.mjs",
    "desktop:mac": "npm run desktop:prepare && electron-builder --mac",
    "desktop:win": "npm run desktop:prepare && electron-builder --win",
    "brand": "electron scripts/brand.cjs",
    "desktop:linux": "npm run desktop:prepare && electron-builder --linux",
    "desktop:all": "npm run desktop:prepare && electron-builder --mac --win --linux",
    "screenshots": "node scripts/screenshots.mjs",
    "marketing": "npm run desktop:prepare && electron scripts/marketing/carousel.cjs && node scripts/marketing/record.mjs"
  },
  "dependencies": {
    "driver.js": "1.8.0",
    "imapflow": "1.7.8",
    "next": "15.5.28",
    "react": "19.1.9",
    "react-dom": "19.1.9"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.30"
    }
  },
  "build": {
    "appId": "app.mailclean.desktop",
    "productName": "MailClean",
    "electronVersion": "44.9.3",
    "directories": {
      "app": "electron",
      "buildResources": "build",
      "output": "dist-desktop"
    },
    "files": [
      "main.cjs",
      "package.json",
      "!**/node_modules/**"
    ],
    "extraResources": [
      {
        "from": "build/config.json",
        "to": "config.json"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "MailClean-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "MailClean ${version}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MailClean-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "MailClean"
    },
    "appx": {
      "applicationId": "MailClean",
      "displayName": "mailclean.app",
      "identityName": "ravimehra9911.mailclean.app",
      "publisher": "CN=73CAAB27-B9D7-4058-9EDF-022A917D59FF",
      "publisherDisplayName": "ravimehra9911",
      "backgroundColor": "transparent",
      "languages": [
        "en-US"
      ],
      "showNameOnTiles": false,
      "artifactName": "MailClean-${version}-store-${arch}.${ext}"
    },
    "afterPack": "scripts/after-pack.cjs",
    "npmRebuild": false,
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "artifactName": "MailClean-linux-x86_64.${ext}",
      "synopsis": "Clean up every inbox in one place",
      "maintainer": "ravimehra9911 <https://github.com/ravimehra9911>"
    }
  },
  "license": "MIT",
  "author": "Ravi Mehra (https://github.com/ravimehra9911)",
  "repository": {
    "type": "git",
    "url": "https://github.com/ravimehra9911/mailclean.git"
  },
  "homepage": "https://github.com/ravimehra9911/mailclean",
  "engines": {
    "node": ">=22.13"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.30"
    }
  }
}
